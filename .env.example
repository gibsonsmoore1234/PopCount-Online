# ─── Database ────────────────────────────────────────────────────────────────
# Leave DATABASE_URL unset to use the embedded PGlite database in .data/pglite
# (real Postgres compiled to WASM — zero setup for local development).
# Set it for production / docker-compose, e.g. postgres://pc:pc@localhost:5432/popularity
DATABASE_URL=
# "true" for hosted Postgres that requires TLS (Neon, Supabase, RDS…)
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Public origin — used for Stripe redirect URLs and metadata.
APP_URL=http://localhost:3000

# ─── Payments (boost credits) ────────────────────────────────────────────────
# stripe | demo | disabled. Defaults to "stripe" when STRIPE_SECRET_KEY is set, otherwise "demo"
# (demo grants credits instantly with no charge — never use demo mode in a public deployment).
PAYMENTS_MODE=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Seed data (development only) ────────────────────────────────────────────
SEED_DEMO_PASSWORD=password123
SEED_ADMIN_PASSWORD=admin12345

# Disable the in-memory rate limiter (e.g. for load tests).
RATE_LIMIT_DISABLED=false
