# ─── Database ────────────────────────────────────────────────────────────────
# Required in production (Neon, Supabase, RDS, docker-compose…).
# Leave unset locally to use the embedded PGlite database in .data/pglite.
DATABASE_URL=
# "true" for hosted Postgres that requires TLS (Neon, Supabase, RDS…)
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Public origin, e.g. https://popcount.ai — used for metadata, robots.txt and sitemap.xml.
APP_URL=http://localhost:3000

# ─── Seed data (development only) ────────────────────────────────────────────
SEED_DEMO_PASSWORD=password123
SEED_ADMIN_PASSWORD=admin12345

# Disable the in-memory rate limiter (e.g. for load tests).
RATE_LIMIT_DISABLED=false
