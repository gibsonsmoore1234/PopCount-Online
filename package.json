{
  "name": "pop-count",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pop Count — location-based Aura ratings inside campus & town bubbles.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "npm run db:prepare && next dev",
    "build": "tsx scripts/migrate.ts --if-configured && next build",
    "start": "npm run db:migrate && next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/seed.ts --reset",
    "db:prepare": "tsx scripts/migrate.ts && tsx scripts/seed.ts --if-empty",
    "check": "npm run typecheck && npm run lint && npm run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@dicebear/collection": "9.4.3",
    "@dicebear/core": "9.4.3",
    "@electric-sql/pglite": "0.5.8",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@tanstack/react-query": "5.104.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "d3-geo": "3.1.1",
    "drizzle-orm": "0.45.4",
    "leaflet": "1.9.4",
    "lucide-react": "1.53.0",
    "motion": "14.0.0",
    "next": "16.4.0",
    "obscenity": "0.4.6",
    "pg": "8.23.1",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "5.0.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "topojson-client": "3.1.0",
    "us-atlas": "3.0.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/d3-geo": "3.1.1",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/topojson-client": "3.1.5",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
